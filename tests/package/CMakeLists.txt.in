cmake_minimum_required(VERSION 3.24)

project(LfQuickPackageSmoke LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

set(_lfquick_components @LFQUICK_PACKAGE_SMOKE_COMPONENTS_ARGS@)
set(_lfquick_qml_plugins @LFQUICK_PACKAGE_SMOKE_QML_PLUGIN_ARGS@)
find_package(LfQuick REQUIRED COMPONENTS ${_lfquick_components})

add_executable(lfquick_package_smoke main.cpp)

foreach(_component IN LISTS _lfquick_components)
    if(NOT TARGET "LfQuick::${_component}")
        message(FATAL_ERROR
            "LfQuick component '${_component}' was reported as found but target "
            "'LfQuick::${_component}' is unavailable")
    endif()
    target_link_libraries(lfquick_package_smoke PRIVATE "LfQuick::${_component}")
endforeach()

foreach(_plugin IN LISTS _lfquick_qml_plugins)
    if(NOT TARGET "LfQuick::${_plugin}")
        message(FATAL_ERROR
            "Static LfQuick QML plugin target 'LfQuick::${_plugin}' is unavailable")
    endif()
    target_link_libraries(lfquick_package_smoke PRIVATE "LfQuick::${_plugin}")
endforeach()

set(_expected_qt_min_version "@LFQUICK_QT_MIN_VERSION@")
if("SafeAreaAdapter" IN_LIST _lfquick_components)
    set(_expected_qt_min_version "6.9.0")
endif()
if("RangeModelAdapter" IN_LIST _lfquick_components)
    set(_expected_qt_min_version "6.10.0")
endif()
if("CanvasPainterAdapter" IN_LIST _lfquick_components
   OR "StyleKit" IN_LIST _lfquick_components)
    set(_expected_qt_min_version "6.12.0")
endif()
if(NOT LfQuick_QT_MIN_VERSION VERSION_EQUAL _expected_qt_min_version)
    message(FATAL_ERROR
        "LfQuick_QT_MIN_VERSION='${LfQuick_QT_MIN_VERSION}' does not match "
        "the built component floor '${_expected_qt_min_version}'")
endif()

if(NOT @BUILD_SHARED_LIBS@)
    get_target_property(_lfquick_core_definitions
        LfQuick::Core INTERFACE_COMPILE_DEFINITIONS)
    if(NOT _lfquick_core_definitions)
        message(FATAL_ERROR
            "Static LfQuick SDK does not export any interface compile definitions")
    endif()
    if(NOT "LFQUICK_STATIC" IN_LIST _lfquick_core_definitions)
        message(FATAL_ERROR
            "Static LfQuick SDK must propagate LFQUICK_STATIC to consumers")
    endif()
endif()
