cmake_minimum_required(VERSION 3.24)

project(LfQuickPackageSmoke LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

set(_lfquick_components @LFQUICK_PACKAGE_SMOKE_COMPONENTS_ARGS@)
find_package(LfQuick REQUIRED COMPONENTS ${_lfquick_components})

add_executable(lfquick_package_smoke main.cpp)

foreach(_component IN LISTS _lfquick_components)
    if(NOT TARGET "LfQuick::${_component}")
        message(FATAL_ERROR
            "LfQuick component '${_component}' was reported as found but target "
            "'LfQuick::${_component}' is unavailable")
    endif()
    target_link_libraries(lfquick_package_smoke PRIVATE "LfQuick::${_component}")
endforeach()

if(NOT @BUILD_SHARED_LIBS@)
    get_target_property(_lfquick_core_definitions
        LfQuick::Core INTERFACE_COMPILE_DEFINITIONS)
    if(NOT _lfquick_core_definitions)
        message(FATAL_ERROR
            "Static LfQuick SDK does not export any interface compile definitions")
    endif()
    if(NOT "LFQUICK_STATIC" IN_LIST _lfquick_core_definitions)
        message(FATAL_ERROR
            "Static LfQuick SDK must propagate LFQUICK_STATIC to consumers")
    endif()
endif()
